{
  "name": "a-garden-apart",
  "version": "1.0.0",
  "private": true,
  "description": "A quiet, cooperative garden for two \u2014 built with Node.js, Socket.IO, and p5.js.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.cjs",
    "test:remote": "node test/remote.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "p5": "^2.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "socket.io-client": "^4.8.4"
  }
}
